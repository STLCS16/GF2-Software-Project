msgid "Logic simulator canvas"
msgstr "Canevas du simulateur logique"

msgid "Mouse button pressed at: %s, %s"
msgstr "Bouton de la souris pressé à : %s, %s"

msgid "Mouse button released at: %s, %s"
msgstr "Bouton de la souris relâché à : %s, %s"

msgid "Mouse left canvas at: %s, %s"
msgstr "La souris a quitté le canevas à : %s, %s"

msgid "Mouse dragged to: %s, %s. Pan is now: %s, %s"
msgstr "Souris glissée vers : %s, %s. Le panoramique est maintenant : %s, %s"

msgid "Negative mouse wheel rotation. Zoom is now: %s"
msgstr "Rotation négative de la molette de la souris. Le zoom est : %s"

msgid "Positive mouse wheel rotation. Zoom is now: %s"
msgstr "Rotation positive de la molette de la souris. Le zoom est : %s"

msgid "&About"
msgstr "&À propos"

msgid "&Exit"
msgstr "&Quitter"

msgid "&File"
msgstr "&Fichier"

msgid "Run"
msgstr "Exécuter"

msgid "Continue"
msgstr "Continuer"

msgid "Stop"
msgstr "Arrêter"

msgid "3D Trace"
msgstr "Trace 3D"

msgid "2D Trace"
msgstr "Trace 2D"

msgid "Ready. Type h for help"
msgstr "Prêt. Tapez h pour obtenir de l'aide"

msgid "Logic Simulator designed by group 14\nDefinition file used: %s"
msgstr "Simulateur Logique conçu par le groupe 14\nFichier de définition utilisé : %s"

msgid "About Logsim"
msgstr "À propos de Logsim"

msgid "Simulation stopped by user."
msgstr "Simulation arrêtée par l'utilisateur."

msgid "Simulation stopped."
msgstr "Simulation arrêtée."

msgid "Switched to 3D trace view."
msgstr "Passage à la vue de trace 3D."

msgid "Switched to 2D trace view."
msgstr "Passage à la vue de trace 2D."

msgid "Switch values:\n"
msgstr "Valeurs des interrupteurs :\n"

msgid "Error: no command entered."
msgstr "Erreur : aucune commande entrée."

msgid "The run button run simulation for 20 cycles.\nThe continue button runs a further 10 cycles.\nCommand list:\nRun for N cycles: r N\nContinue for N cycles: c N\nSet the value of switch N: s SWN 1 or s SWN 0\nAdd a monitor on Gate N: m GN\nRemove a monitor on Gate N: z GN\nPress the stop button to quit the simulation\n"
msgstr "Le bouton exécuter lance la simulation pour 20 cycles.\nLe bouton continuer exécute 10 cycles supplémentaires.\nListe des commandes :\nExécuter pour N cycles : r N\nContinuer pour N cycles : c N\nRégler la valeur de l'interrupteur N : s SWN 1 ou s SWN 0\nAjouter un moniteur sur la Porte N : m GN\nRetirer un moniteur sur la Porte N : z GN\nAppuyez sur le bouton arrêter pour quitter la simulation\n"

msgid "Error: unknown command '%s'."
msgstr "Erreur : commande inconnue '%s'."

msgid "Error: usage is s X N, for example s SW1 1."
msgstr "Erreur : l'utilisation est s X N, par exemple s SW1 1."

msgid "Error: switch value must be 0 or 1."
msgstr "Erreur : la valeur de l'interrupteur doit être 0 ou 1."

msgid "Switch %s set to %s."
msgstr "L'interrupteur %s a été réglé sur %s."

msgid "Error: usage is m X, for example m G1."
msgstr "Erreur : l'utilisation est m X, par exemple m G1."

msgid "Monitor on %s already exists."
msgstr "Le moniteur sur %s existe déjà."

msgid "%s is not an output."
msgstr "%s n'est pas une sortie."

msgid "%s is not defined."
msgstr "%s n'est pas défini."

msgid "Could not add monitor on %s."
msgstr "Impossible d'ajouter le moniteur sur %s."

msgid "Error: usage is z X, for example z G1."
msgstr "Erreur : l'utilisation est z X, par exemple z G1."

msgid "Error: device '%s' is not defined."
msgstr "Erreur : le dispositif '%s' n'est pas défini."

msgid "Error: output '%s' is not defined."
msgstr "Erreur : la sortie '%s' n'est pas définie."

msgid "Error: device '%s' is not in the network."
msgstr "Erreur : le dispositif '%s' n'est pas dans le réseau."

msgid "Error: signal '%s' is not an output."
msgstr "Erreur : le signal '%s' n'est pas une sortie."

msgid "Error: no monitor exists on signal '%s'."
msgstr "Erreur : aucun moniteur n'existe sur le signal '%s'."

msgid "Monitor removed: %s"
msgstr "Moniteur retiré : %s"

msgid "Error: usage is %s."
msgstr "Erreur : l'utilisation est %s."

msgid "Error: number of cycles must be an integer."
msgstr "Erreur : le nombre de cycles doit être un entier."

msgid "Error: number of cycles must be positive."
msgstr "Erreur : le nombre de cycles doit être positif."

msgid "Error: simulation is already running."
msgstr "Erreur : la simulation est déjà en cours."

msgid "Running for %s cycle(s)."
msgstr "En cours d'exécution pour %s cycle(s)."

msgid "Simulation finished."
msgstr "Simulation terminée."

msgid "Simulation finished after %s cycle(s)."
msgstr "Simulation terminée après %s cycle(s)."

msgid "Error: simulation failed to reach steady state."
msgstr "Erreur : la simulation n'a pas réussi à atteindre l'état stable."

msgid "Simulation error."
msgstr "Erreur de simulation."

msgid "Cycle %s"
msgstr "Cycle %s"

msgid "Error: unknown switch %s."
msgstr "Erreur : interrupteur inconnu %s."

msgid "Set switch %s to %s."
msgstr "Interrupteur %s réglé sur %s."

msgid "Added monitor on %s."
msgstr "Moniteur ajouté sur %s."

msgid "Removed monitor from %s."
msgstr "Moniteur retiré de %s."